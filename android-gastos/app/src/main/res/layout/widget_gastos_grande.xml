<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gastos Express"
            android:textColor="#EAF2F8"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/f_hoy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="#FF9A7A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/f_mes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8497A7"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/f_cat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#7FC7FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/f_monto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:text="$ 0"
        android:textColor="#EAF2F8"
        android:textSize="38sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="0.7"
        android:orientation="horizontal">

        <TextView android:id="@+id/cat_0" style="@style/CatBtn" />
        <TextView android:id="@+id/cat_1" style="@style/CatBtn" />
        <TextView android:id="@+id/cat_2" style="@style/CatBtn" />
        <TextView android:id="@+id/cat_3" style="@style/CatBtn" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:orientation="horizontal">

        <TextView android:id="@+id/cat_4" style="@style/CatBtn" />
        <TextView android:id="@+id/cat_5" style="@style/CatBtn" />
        <TextView android:id="@+id/cat_6" style="@style/CatBtn" />
        <TextView android:id="@+id/cat_7" style="@style/CatBtn" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_1" style="@style/KeyBtn" android:text="1" />
        <TextView android:id="@+id/key_2" style="@style/KeyBtn" android:text="2" />
        <TextView android:id="@+id/key_3" style="@style/KeyBtn" android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_4" style="@style/KeyBtn" android:text="4" />
        <TextView android:id="@+id/key_5" style="@style/KeyBtn" android:text="5" />
        <TextView android:id="@+id/key_6" style="@style/KeyBtn" android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_7" style="@style/KeyBtn" android:text="7" />
        <TextView android:id="@+id/key_8" style="@style/KeyBtn" android:text="8" />
        <TextView android:id="@+id/key_9" style="@style/KeyBtn" android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_000" style="@style/KeyBtn" android:text="000" />
        <TextView android:id="@+id/key_0" style="@style/KeyBtn" android:text="0" />
        <TextView android:id="@+id/key_del" style="@style/KeyBtn" android:text="⌫" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_nota"
            style="@style/CatBtn"
            android:layout_weight="1"
            android:text="+ Nota"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="2"
            android:background="@drawable/btn_accent"
            android:gravity="center"
            android:text="Guardar / Enviar"
            android:textColor="#06121C"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/hist_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="#8497A7"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/hist_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#56636F"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/hist_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#56636F"
        android:textSize="12sp" />
</LinearLayout>
