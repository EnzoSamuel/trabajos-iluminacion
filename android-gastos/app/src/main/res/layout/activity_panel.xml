<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E13"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gastos Express"
                android:textColor="#EAF2F8"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p_hoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="#FF9A7A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/p_ajustes"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/chip_bg"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Cuenta"
                android:textColor="#8497A7"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- DÓLAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.12"
                    android:text="DÓLAR EN VIVO"
                    android:textColor="#8497A7"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/p_hora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4FD699"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/p_dolar_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/p_valor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#EAF2F8"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8497A7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/p_tick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/p_ahorro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#9FF0C8"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- GASTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="CARGAR UN GASTO"
                android:textColor="#8497A7"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/p_cat_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/p_monto"
                style="@style/Campo"
                android:hint="Monto en $"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="10"
                android:maxLines="1" />

            <EditText
                android:id="@+id/p_nota"
                style="@style/Campo"
                android:hint="Descripción (opcional)"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLines="2" />

            <Button
                android:id="@+id/p_fecha"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:text="Fecha: hoy"
                android:textAllCaps="false"
                android:textColor="#EAF2F8" />

            <Button
                android:id="@+id/p_enviar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_accent"
                android:text="Guardar / Enviar"
                android:textAllCaps="false"
                android:textColor="#06121C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p_hist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#8497A7"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
