<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Gastos Express</string>
    <string name="widget_desc">Registrá gastos rápido desde la pantalla de inicio</string>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0E13</item>
        <item name="android:statusBarColor">#0A0E13</item>
        <item name="android:navigationBarColor">#0A0E13</item>
    </style>

    <style name="DialogTheme" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#EAF2F8</item>
        <item name="android:textColorHint">#56636F</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CatBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#EAF2F8</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WidgetChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#EAF2F8</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
